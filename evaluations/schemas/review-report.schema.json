{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reality-ledger.example.invalid/schemas/review-report.schema.json",
  "title": "Reality Ledger local release gate report",
  "type": "object",
  "required": [
    "schemaVersion",
    "generatedAt",
    "decision",
    "counts",
    "environment",
    "gates"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "decision": {
      "enum": [
        "pass",
        "fail",
        "inconclusive"
      ]
    },
    "counts": {
      "type": "object",
      "required": [
        "pass",
        "fail",
        "inconclusive"
      ],
      "additionalProperties": false,
      "properties": {
        "pass": {
          "type": "integer",
          "minimum": 0
        },
        "fail": {
          "type": "integer",
          "minimum": 0
        },
        "inconclusive": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "environment": {
      "type": "object"
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "detail"
        ],
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "inconclusive"
            ]
          },
          "detail": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "object"
          }
        }
      }
    }
  }
}
